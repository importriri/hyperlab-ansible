# Per-machine input for the sway cockpit.
# Rendered by privatestack-ansible (roles/host_desktop_sway). Do not hand-edit: the
# next run overwrites this file - change the variables instead.
#
# sway has no keyboard default worth inheriting. With no xkb_layout the
# session runs `us`, whatever the physical keyboard and the console say -
# and the first thing that breaks is every password with a symbol in it.
# The console keymap is a different setting entirely (vconsole, owned by
# the base install): a correct sway layout does not fix a TTY, nor the
# other way round.
input type:keyboard {
    xkb_layout {{ host_desktop_sway_input.keyboard_layout_cycle | join(',') }}
{% if host_desktop_sway_input.keyboard_variant %}
    xkb_variant {{ host_desktop_sway_input.keyboard_variant }},,
{% endif %}
{% if host_desktop_sway_input.keyboard_options %}
    xkb_options {{ host_desktop_sway_input.keyboard_options }}
{% endif %}
}

input type:touchpad {
{% for setting, value in host_desktop_sway_input.touchpad | dictsort %}
    {{ setting }} {{ value }}
{% endfor %}
}
