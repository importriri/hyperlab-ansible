#!/usr/bin/env bash
# gpu-handoff - libvirt qemu hook. Managed by hyperlab-ansible.
#
# Static reviewed fixtures live in /etc/gpu-handoff/domains.
# C10 product Machines live in root-owned /etc/gpu-handoff/domains.d/*.conf.
#
# Both map an exact libvirt domain to a GPU handoff contamination profile:
#   clean(3) -> dev(2) -> dirty(1) -> lab(0)
#
# The guest network identity is deliberately not read here. Between reboots the
# physical GPU may only move DOWN this independent handoff ladder.
set -u

ROTATION_FILE="${GPU_HANDOFF_ROTATION:-/etc/gpu-handoff/rotation}"
DOMAINS_FILE="${GPU_HANDOFF_DOMAINS:-/etc/gpu-handoff/domains}"
MANAGED_DIR="${GPU_HANDOFF_MANAGED_DIR:-/etc/gpu-handoff/domains.d}"
STATE_DIR="${GPU_HANDOFF_STATE_DIR:-/run/gpu-handoff}"
STATE_FILE="${STATE_DIR}/trust"

domain="${1:-}"
phase="${2:-}"

[[ "${phase}" == "prepare" ]] || exit 0

if [[ -z "${domain}" ]]; then
    echo "gpu-handoff: missing domain argument: refusing (fail closed)" >&2
    exit 1
fi

for config in "${DOMAINS_FILE}" "${ROTATION_FILE}"; do
    if [[ ! -r "${config}" || ! -f "${config}" || -L "${config}" ]]; then
        echo "gpu-handoff: ${config} missing, redirected or unreadable: refusing (fail closed)" >&2
        exit 1
    fi
done

if [[ ! -d "${MANAGED_DIR}" || -L "${MANAGED_DIR}" ]]; then
    echo "gpu-handoff: ${MANAGED_DIR} missing or redirected: refusing (fail closed)" >&2
    exit 1
fi

profile=""
domain_entries=0
declare -A seen_domains=()

read_domain_file() {
    local file="$1"
    local expected_name="${2:-}"
    local name=""
    local handoff=""
    local extra=""

    while read -r name handoff extra; do
        if [[ -z "${name}" || "${name}" == \#* ]]; then
            continue
        fi

        if [[ -n "${extra:-}" ||
              ! "${name}" =~ ^[a-z0-9][a-z0-9-]{1,30}$ ||
              ! "${handoff}" =~ ^[a-z]+$ ]]; then
            echo "gpu-handoff: corrupt domain line in ${file} ('${name} ${handoff} ${extra:-}'): refusing" >&2
            return 1
        fi

        if [[ -n "${expected_name}" && "${name}" != "${expected_name}" ]]; then
            echo "gpu-handoff: ${file} names ${name}, expected ${expected_name}: refusing" >&2
            return 1
        fi

        if [[ -n "${seen_domains[$name]:-}" ]]; then
            echo "gpu-handoff: duplicate domain '${name}': refusing" >&2
            return 1
        fi

        seen_domains["${name}"]=1
        domain_entries=$((domain_entries + 1))

        if [[ "${name}" == "${domain}" ]]; then
            profile="${handoff}"
        fi
    done < "${file}"
}

read_domain_file "${DOMAINS_FILE}" || exit 1

shopt -s nullglob
managed_configs=("${MANAGED_DIR}"/*.conf)
shopt -u nullglob

for config in "${managed_configs[@]}"; do
    if [[ ! -f "${config}" || -L "${config}" ]]; then
        echo "gpu-handoff: unsafe managed policy ${config}: refusing" >&2
        exit 1
    fi

    basename="${config##*/}"
    expected_name="${basename%.conf}"

    if [[ ! "${expected_name}" =~ ^[a-z0-9][a-z0-9-]{1,30}$ ]]; then
        echo "gpu-handoff: invalid managed policy filename ${basename}: refusing" >&2
        exit 1
    fi

    read_domain_file "${config}" "${expected_name}" || exit 1
done

if (( domain_entries == 0 )); then
    echo "gpu-handoff: no valid GPU domain policy entries: refusing" >&2
    exit 1
fi

# A domain absent from both reviewed policy surfaces is not a GPU domain and
# passes without touching GPU contamination state - but only if it really
# carries no PCI passthrough. libvirt hands the hook the domain XML on stdin;
# an unmapped domain with a PCI hostdev would otherwise take the device
# without ever lowering the recorded ladder level.
if [[ -z "${profile}" ]]; then
    domain_xml="$(cat)"
    if [[ -z "${domain_xml}" ]]; then
        echo "gpu-handoff: no domain XML for unlisted ${domain}: refusing (fail closed)" >&2
        exit 1
    fi
    if grep -Eq "<hostdev[^>]*type=['\"]pci['\"]|<interface[^>]*type=['\"]hostdev['\"]" <<< "${domain_xml}"; then
        echo "gpu-handoff: REFUSING ${domain}: PCI passthrough without a reviewed GPU handoff policy" >&2
        exit 1
    fi
    exit 0
fi

trust=""
rotation_entries=0
declare -A seen_profiles=()

while read -r handoff level extra; do
    if [[ -z "${handoff}" || "${handoff}" == \#* ]]; then
        continue
    fi

    if [[ -n "${extra:-}" ||
          ! "${handoff}" =~ ^[a-z]+$ ||
          ! "${level}" =~ ^[0-9]+$ ]]; then
        echo "gpu-handoff: corrupt rotation line ('${handoff} ${level} ${extra:-}'): refusing" >&2
        exit 1
    fi

    if [[ -n "${seen_profiles[$handoff]:-}" ]]; then
        echo "gpu-handoff: duplicate handoff profile '${handoff}': refusing" >&2
        exit 1
    fi

    seen_profiles["${handoff}"]=1
    rotation_entries=$((rotation_entries + 1))

    if [[ "${handoff}" == "${profile}" ]]; then
        trust="${level}"
    fi
done < "${ROTATION_FILE}"

if (( rotation_entries == 0 )); then
    echo "gpu-handoff: ${ROTATION_FILE} has no valid entries: refusing" >&2
    exit 1
fi

if [[ -z "${trust}" ]]; then
    echo "gpu-handoff: domain ${domain} maps to unknown profile ${profile}: refusing" >&2
    exit 1
fi

if ! mkdir -p "${STATE_DIR}"; then
    echo "gpu-handoff: cannot create ${STATE_DIR}: refusing" >&2
    exit 1
fi

if [[ -e "${STATE_FILE}" ]]; then
    current="$(cat "${STATE_FILE}" 2>/dev/null || true)"

    if [[ ! "${current}" =~ ^[0-9]+$ ]]; then
        echo "gpu-handoff: corrupt state '${current}': refusing - a reboot resets it" >&2
        exit 1
    fi

    if (( trust > current )); then
        echo "gpu-handoff: REFUSING ${domain} (${profile}/${trust}): GPU held at trust ${current}; trust only rises through a reboot" >&2
        exit 1
    fi
fi

printf '%s\n' "${trust}" > "${STATE_FILE}"
exit 0
