-- Managed by hyperlab-ansible.
-- Guest workstation only. HyperLab host controls never belong here.

require("theme")

-- Guest compositor namespace is deliberately different from the host.
-- Host = SUPER; guest = ALT. Looking Glass keeps RIGHTCTRL for transport escape.
local main_mod = "ALT"

{% if guest_desktop_hyprland_headless_monitor %}
hl.monitor({
    output = "{{ guest_desktop_hyprland_headless_output }}",
    mode = "{{ guest_desktop_hyprland_headless_mode }}",
    position = "{{ guest_desktop_hyprland_headless_position }}",
    scale = {{ guest_desktop_hyprland_headless_scale }},
})
{% else %}
hl.monitor({
    output = "",
    mode = "preferred",
    position = "auto",
    scale = "auto",
})
{% endif %}

hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")
hl.env("XDG_CURRENT_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_TYPE", "wayland")

hl.config({
    general = {
        gaps_in = 8,
        gaps_out = 16,
        border_size = 2,
        resize_on_border = true,
        allow_tearing = false,
        layout = "dwindle",

    },

    decoration = {
        rounding = 14,
        rounding_power = 2,

        -- Inactive windows recede a little; the focused one stays solid.
        active_opacity = 1.0,
        inactive_opacity = 0.94,
        dim_inactive = true,
        dim_strength = 0.06,

        blur = {
            enabled = true,
            size = 8,
            passes = 3,
            vibrancy = 0.2,
        },

        shadow = {
            enabled = true,
            range = 28,
            render_power = 3,
        },
    },

    animations = {
        enabled = true,
    },

    input = {
        kb_layout = "it,us,ara",
        follow_mouse = 1,

        touchpad = {
            natural_scroll = true,
        },
    },

    dwindle = {
        preserve_split = true,
    },

    misc = {
        force_default_wallpaper = 0,
        disable_hyprland_logo = true,
        focus_on_activate = true,
    },
})

hl.curve(
    "guestEase",
    {
        type = "bezier",
        points = {
            {0.16, 1},
            {0.30, 1},
        },
    }
)

hl.animation({
    leaf = "windows",
    enabled = true,
    speed = 6,
    bezier = "guestEase",
})

hl.animation({
    leaf = "windowsIn",
    enabled = true,
    speed = 5,
    bezier = "guestEase",
    style = "popin 80%",
})

hl.animation({
    leaf = "windowsOut",
    enabled = true,
    speed = 5,
    bezier = "guestEase",
    style = "popin 80%",
})

hl.animation({
    leaf = "border",
    enabled = true,
    speed = 8,
    bezier = "guestEase",
})

hl.animation({
    leaf = "fade",
    enabled = true,
    speed = 5,
    bezier = "guestEase",
})

hl.animation({
    leaf = "workspaces",
    enabled = true,
    speed = 5,
    bezier = "guestEase",
    style = "slide",
})

hl.on("hyprland.start", function()
{% if guest_desktop_hyprland_headless_monitor %}
    hl.exec_cmd(
        "hyprctl output create headless "
        .. "{{ guest_desktop_hyprland_headless_output }}"
    )
{% endif %}
    hl.exec_cmd(
        "dbus-update-activation-environment "
        .. "--systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP"
    )

    hl.exec_cmd(
        "systemctl --user start hyprpolkitagent.service"
    )

{% if guest_desktop_hyprland_shell == 'quickshell' %}
    -- The Workspace Shell; it falls back to Waybar on its own if it fails.
    hl.exec_cmd("hyperlab-workspace session")
{% else %}
    hl.exec_cmd("waybar")
{% endif %}
    hl.exec_cmd("mako")
    hl.exec_cmd("hypridle")

    hl.exec_cmd(
        "sleep 1 && "
        .. "privatestack-guest-theme session-start"
    )

    hl.exec_cmd(
        "wl-paste --type text --watch cliphist store"
    )

    -- Land on Desk 1 rather than on the unassigned workspace 1.
    hl.exec_cmd("hyperlab-desk desk 1")
end)

hl.bind(
    main_mod .. " + Return",
    hl.dsp.exec_cmd("kitty")
)

hl.bind(
    main_mod .. " + E",
    hl.dsp.exec_cmd("thunar")
)

-- Desks overview, launcher and new project. The helper reaches the
-- Workspace Shell and falls back to rofi when the shell is not running.
hl.bind(
    main_mod .. " + D",
    hl.dsp.exec_cmd("hyperlab-workspace overview")
)

hl.bind(
    main_mod .. " + space",
    hl.dsp.exec_cmd("hyperlab-workspace launcher")
)

hl.bind(
    main_mod .. " + N",
    hl.dsp.exec_cmd("hyperlab-workspace new-project")
)

hl.bind(
    main_mod .. " + H",
    hl.dsp.exec_cmd("hyperlab-workspace cheatsheet")
)

hl.bind(
    main_mod .. " + R",
    hl.dsp.exec_cmd("rofi -show drun")
)

hl.bind(
    main_mod .. " + SHIFT + T",
    hl.dsp.exec_cmd(
        "privatestack-guest-theme next"
    )
)

hl.bind(
    main_mod .. " + SHIFT + W",
    hl.dsp.exec_cmd(
        "privatestack-guest-theme wallpaper-next"
    )
)

hl.bind(
    main_mod .. " + L",
    hl.dsp.exec_cmd(
        "pidof hyprlock || hyprlock"
    )
)

hl.bind(
    main_mod .. " + Q",
    hl.dsp.window.close()
)

-- True fullscreen covers the top-layer bar; maximization keeps its work area.
hl.bind(
    main_mod .. " + F",
    hl.dsp.window.fullscreen({
        action = "toggle",
        mode = "fullscreen",
    })
)

hl.bind(
    main_mod .. " + V",
    hl.dsp.window.float({
        action = "toggle",
    })
)

hl.bind(
    main_mod .. " + P",
    hl.dsp.window.pseudo()
)

hl.bind(
    main_mod .. " + J",
    hl.dsp.layout("togglesplit")
)

hl.bind(
    main_mod .. " + left",
    hl.dsp.focus({
        direction = "left",
    })
)

hl.bind(
    main_mod .. " + right",
    hl.dsp.focus({
        direction = "right",
    })
)

hl.bind(
    main_mod .. " + up",
    hl.dsp.focus({
        direction = "up",
    })
)

hl.bind(
    main_mod .. " + down",
    hl.dsp.focus({
        direction = "down",
    })
)

hl.bind(
    main_mod .. " + SHIFT + left",
    hl.dsp.window.move({
        direction = "left",
    })
)

hl.bind(
    main_mod .. " + SHIFT + right",
    hl.dsp.window.move({
        direction = "right",
    })
)

hl.bind(
    main_mod .. " + SHIFT + up",
    hl.dsp.window.move({
        direction = "up",
    })
)

hl.bind(
    main_mod .. " + SHIFT + down",
    hl.dsp.window.move({
        direction = "down",
    })
)

-- Desks and their workspaces. Desk d owns workspaces d*10+1 .. d*10+9;
-- hyperlab-desk does the arithmetic and remembers the last slot of each
-- Desk, so a key never needs to know which Desk is current.
--   ALT + n                 go to Desk n
--   ALT + SHIFT + n         move the window to Desk n
--   ALT + CTRL + n          go to workspace n of this Desk
--   ALT + CTRL + SHIFT + n  move the window to workspace n of this Desk
for index = 1, 9 do
    local key = tostring(index)

    hl.bind(
        main_mod .. " + " .. key,
        hl.dsp.exec_cmd("hyperlab-desk desk " .. key)
    )

    hl.bind(
        main_mod .. " + SHIFT + " .. key,
        hl.dsp.exec_cmd("hyperlab-desk move-to-desk " .. key)
    )

    hl.bind(
        main_mod .. " + CTRL + " .. key,
        hl.dsp.exec_cmd("hyperlab-desk workspace " .. key)
    )

    hl.bind(
        main_mod .. " + CTRL + SHIFT + " .. key,
        hl.dsp.exec_cmd("hyperlab-desk move-to-workspace " .. key)
    )
end

hl.bind(
    main_mod .. " + Page_Down",
    hl.dsp.exec_cmd("hyperlab-desk desk-next")
)

hl.bind(
    main_mod .. " + Page_Up",
    hl.dsp.exec_cmd("hyperlab-desk desk-prev")
)

hl.bind(
    main_mod .. " + mouse:272",
    hl.dsp.window.drag(),
    {
        mouse = true,
    }
)

hl.bind(
    main_mod .. " + mouse:273",
    hl.dsp.window.resize(),
    {
        mouse = true,
    }
)

hl.bind(
    main_mod .. " + XF86AudioRaiseVolume",
    hl.dsp.exec_cmd(
        "wpctl set-volume -l 1 "
        .. "@DEFAULT_AUDIO_SINK@ 5%+"
    ),
    {
        locked = true,
        repeating = true,
    }
)

hl.bind(
    main_mod .. " + XF86AudioLowerVolume",
    hl.dsp.exec_cmd(
        "wpctl set-volume "
        .. "@DEFAULT_AUDIO_SINK@ 5%-"
    ),
    {
        locked = true,
        repeating = true,
    }
)

hl.bind(
    main_mod .. " + XF86AudioMute",
    hl.dsp.exec_cmd(
        "wpctl set-mute "
        .. "@DEFAULT_AUDIO_SINK@ toggle"
    ),
    {
        locked = true,
    }
)

hl.bind(
    main_mod .. " + XF86AudioPlay",
    hl.dsp.exec_cmd("playerctl play-pause"),
    {
        locked = true,
    }
)

hl.bind(
    main_mod .. " + XF86AudioNext",
    hl.dsp.exec_cmd("playerctl next"),
    {
        locked = true,
    }
)

hl.bind(
    main_mod .. " + XF86AudioPrev",
    hl.dsp.exec_cmd("playerctl previous"),
    {
        locked = true,
    }
)

-- Applications may ask to open maximized; kitty does on this guest. A
-- maximized window covers the tiled ones, so a second terminal looked like
-- it replaced the first. Tiling decides window sizes, as in Hyprland's own
-- default configuration; ALT+F still makes a window fullscreen.
hl.window_rule({
    name = "suppress-maximize-requests",

    match = {
        class = ".*",
    },

    suppress_event = "maximize",
})

hl.window_rule({
    name = "float-file-roller",

    match = {
        class = "org.gnome.FileRoller",
    },

    float = true,
})
