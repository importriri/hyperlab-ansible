include ~/.config/hyperlab/palette.sway
# sway - privatestack desktop brick - Hyperlab palettes
# Hyperlab shell: Waybar is the primary cockpit; native Swaybar remains a
# crash-safe fallback. Shared-palette Rofi and four-theme wallpapers stay
# entirely in official-repository components.
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $filemanager /usr/local/bin/privatestack-superfile
set $menu rofi -show drun -theme ~/.config/rofi/rofi-launcher.rasi
set $powermenu /usr/local/bin/privatestack-powermenu
set $hyperpalette /usr/local/bin/privatestack-hyperlab-palette
set $hyperdomains /usr/local/bin/privatestack-hyperlab-domains --surface drawer --section vms
set $hyperpanel /usr/local/bin/privatestack-hyperlab-domains --surface drawer --section diagnostics
set $controls /usr/local/bin/privatestack-controls menu

# selected shared palette
font pango:JetBrainsMono Nerd Font 10

# The backdrop ships with the role (see roles/desktop/tasks/main.yml).
# Drop any other image at the same path to swap it - no ansible change.
output * bg /usr/share/backgrounds/privatestack/public/green/01.png fill

gaps inner 6
gaps outer 4
smart_gaps on
default_border pixel 3
default_floating_border pixel 3
smart_borders on

# gaps on/off without a reload: rice for screenshots, dense for work
bindsym $mod+g gaps inner all set 0; gaps outer all set 0
bindsym $mod+Shift+g gaps inner all set 6; gaps outer all set 4

# class                 border    bg      text      indicator childborder

# Per-machine input - keyboard layout and touchpad - is rendered from
# variables into this file. sway resolves a relative include against the
# directory of the file doing the including, so adopting the cockpit on a
# different laptop is a variable change, not a patch to this config.
include input.conf

# Dialogs and pickers float instead of stealing half the tiling tree.
for_window [app_id="^pavucontrol$"]          floating enable
for_window [app_id="^blueman-manager$"]      floating enable
for_window [app_id="^nm-connection-editor$"] floating enable
for_window [app_id="^looking-glass$"]        floating enable
# The panel is a fixed-size cockpit, not a tile: it draws a table and a log
# pane and needs its own geometry rather than whatever half of the screen is
# free at the time.
for_window [app_id="^hyperlab-panel$"]       floating enable, resize set 1120 720
for_window [app_id="^floatterm$"]            floating enable, resize set 960 560
for_window [app_id="^superfile$"]            floating enable, resize set 1200 800, move position center
for_window [app_id="^hyperlab-operation$"]   floating enable, resize set 980 560
for_window [app_id="^imv$"]                  floating enable, resize set 960 560
for_window [app_id="^mpv$"]                  floating enable, resize set 960 560
# Both of these only ever match xwayland views, and they are NOT symmetric:
# window_role takes a regex, window_type takes one literal type from a
# fixed list. An unparsable window_type empties the whole criteria and
# sway refuses the line at startup - so, one line per type.
for_window [window_role="pop-up|bubble|dialog|task_dialog"] floating enable
for_window [window_type="dialog"]            floating enable
for_window [window_type="menu"]              floating enable

# A touch of transparency on the terminal only - readability first.
for_window [app_id="^foot$"] opacity 0.82
for_window [app_id="^floatterm$"] opacity 0.80
for_window [app_id="^superfile$"] opacity 0.88
for_window [app_id="^hyperlab-operation$"] opacity 0.84
for_window [app_id="^(firefox|org.mozilla.firefox)$"] opacity 0.90

focus_follows_mouse no

bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec foot --app-id=floatterm
bindsym $mod+Shift+f exec $filemanager
bindsym $mod+d exec $menu
bindsym $mod+x exec $powermenu
# One binding opens the palette, which is generated from the CLI, so no key
# here can ever name an action that no longer exists.
bindsym $mod+F1 exec $hyperpalette
bindsym $mod+F2 exec $hyperpanel
bindsym $mod+F3 exec foot --app-id=floatterm bash -lc 'hyperlabctl doctor; read -r _'
bindsym $mod+F4 exec $hyperdomains
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Escape exec /usr/local/bin/privatestack-swaylock
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
bindsym $mod+Shift+b exec /usr/local/bin/privatestack-waybar toggle
bindsym $mod+Shift+t exec /usr/local/bin/privatestack-theme cycle
bindsym $mod+Shift+w exec /usr/local/bin/privatestack-theme mode-toggle
# Keyboard layout cycling uses a collision-free route; no unbind directives
# are needed because the historical routes are absent from this canonical file.
bindsym $mod+Ctrl+space exec /usr/local/bin/privatestack-keyboard cycle
bindsym $mod+Shift+p exec $controls

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

bindsym $mod+slash workspace back_and_forth
bindsym $mod+period workspace next
bindsym $mod+comma workspace prev
bindsym $mod+minus move scratchpad
bindsym $mod+equal scratchpad show

bindsym $mod+f fullscreen toggle
bindsym $mod+o exec /usr/local/bin/privatestack-opacity-toggle
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
floating_modifier $mod normal

mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# screenshots: region to clipboard, full screen with $mod
bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Print exec grim - | wl-copy

# media keys
bindsym XF86AudioRaiseVolume exec pamixer -i 5
bindsym XF86AudioLowerVolume exec pamixer -d 5
bindsym XF86AudioMute exec pamixer -t
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# GTK apps read these from the settings portal; the ini file in
# ~/.config/gtk-3.0 covers the ones that do not.
set $gnome-schema org.gnome.desktop.interface
exec_always {
    gsettings set $gnome-schema color-scheme 'prefer-dark'
    gsettings set $gnome-schema icon-theme 'Papirus-Dark'
    gsettings set $gnome-schema font-name 'JetBrainsMono Nerd Font 10'
}

# Native Swaybar is the automatic fallback. The Waybar supervisor hides it
# while the primary bar is healthy and restores it after repeated startup
# failures, so a cosmetic process can never leave the session without controls.
bar {
    id bar-0
    position top
    mode invisible
    hidden_state show
    modifier none
    workspace_buttons yes
    wrap_scroll no
    strip_workspace_numbers no
    strip_workspace_name no
    font pango:JetBrainsMono Nerd Font 10
    height 36
    status_command /usr/local/bin/privatestack-swaybar-status
    status_padding 0
    status_edge_padding 4
    separator_symbol ""
    icon_theme Papirus-Dark

    colors {
        background $hl_base
        statusline $hl_text
        separator $hl_overlay
        focused_workspace $hl_accent $hl_accent $hl_base
        active_workspace $hl_overlay $hl_surface $hl_text
        inactive_workspace $hl_overlay $hl_base $hl_subtext
        urgent_workspace $hl_bad $hl_bad $hl_base
        binding_mode $hl_warn $hl_warn $hl_base
    }
}

# Warm the single-instance GTK control plane before the first click. Subsequent
# routes reuse the resident process instead of importing GTK and Python again.
exec_always /usr/local/bin/privatestack-hyperlab-domains --warm

# Start the supervised primary bar. It restores bar-0 automatically if Waybar
# crashes repeatedly.
exec_always /usr/local/bin/privatestack-waybar

# Apply the persisted four-theme palette and wallpaper source mode and start one 60-second wallpaper
# rotator. The controller uses flock, so reloads never create duplicate loops.
exec_always /usr/local/bin/privatestack-theme session-start
exec_always /usr/local/bin/privatestack-keyboard session-start
exec_always /usr/local/bin/privatestack-theme daemon

exec mako
exec swayidle -w \
    timeout 600 '/usr/local/bin/privatestack-swaylock -f' \
    timeout 900 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep '/usr/local/bin/privatestack-swaylock -f'

include /etc/sway/config.d/*
