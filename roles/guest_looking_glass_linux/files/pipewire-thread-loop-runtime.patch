 static struct pipewire * this = NULL;
 
+// HyperLab frame watchdog (begin)
+// A stream can stay "streaming" while no usable frame arrives, and a capture
+// timeout is not logged, so the sender went silent for good. Warn once after
+// HL_STALL_WARN_US without a usable frame, and restart the capture (a new
+// portal session) after HL_STALL_RESTART_US. lastFrameUs is the start of the
+// capture or the last usable frame.
+#define HL_STALL_WARN_US    (10ULL * 1000000ULL)
+#define HL_STALL_RESTART_US (30ULL * 1000000ULL)
+
+enum HLStallAction
+{
+  HL_STALL_NONE,
+  HL_STALL_WARN,
+  HL_STALL_RESTART
+};
+
+static enum HLStallAction hlStallAction(uint64_t nowUs, uint64_t lastFrameUs,
+    bool warned)
+{
+  const uint64_t idleUs = nowUs > lastFrameUs ? nowUs - lastFrameUs : 0;
+  if (idleUs >= HL_STALL_RESTART_US)
+    return HL_STALL_RESTART;
+  if (idleUs >= HL_STALL_WARN_US && !warned)
+    return HL_STALL_WARN;
+  return HL_STALL_NONE;
+}
+// HyperLab frame watchdog (end)
