 static void pipewire_stop(void)
 {
+  pw_thread_loop_lock(this->threadLoop);
+
+  /*
+   * Do not disconnect a live stream from another thread while the PipeWire
+   * loop can still dispatch process/state callbacks. Mark capture stopped,
+   * wake any waiter, then let deinit join the PipeWire loop first.
+   */
   this->stop = true;
-  pw_stream_disconnect(this->stream);
+  this->hasFormat = false;
+  this->frameData = NULL;
   pw_thread_loop_signal(this->threadLoop, false);
+
+  pw_thread_loop_unlock(this->threadLoop);
 }
 
