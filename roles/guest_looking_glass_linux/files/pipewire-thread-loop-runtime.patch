 static struct pipewire * this = NULL;
 
+// HyperLab frame watchdog (begin)
+// A capture timeout is not logged, so a stream that delivers nothing looks
+// like one that works. Log once after HL_STALL_WARN_US without a usable
+// frame, so the silence and its start are on record. Silence alone is not a
+// failure: the compositor probably sends no frame while nothing changes,
+// and a capture restart on silence hung the sender for good
+// (problems/looking-glass-sender-hung-after-capture-stop.md). The capture
+// restarts only when the stream or the core reports a failure. lastFrameUs
+// is the start of the capture or the last usable frame.
+#define HL_STALL_WARN_US    (10ULL * 1000000ULL)
+
+enum HLStallAction
+{
+  HL_STALL_NONE,
+  HL_STALL_WARN
+};
+
+static enum HLStallAction hlStallAction(uint64_t nowUs, uint64_t lastFrameUs,
+    bool warned)
+{
+  const uint64_t idleUs = nowUs > lastFrameUs ? nowUs - lastFrameUs : 0;
+  if (idleUs >= HL_STALL_WARN_US && !warned)
+    return HL_STALL_WARN;
+  return HL_STALL_NONE;
+}
+// HyperLab frame watchdog (end)
+
+// HyperLab accept handshake (begin)
+// A restart stops the capture without reading the frame a callback is
+// handing over, so that callback would wait forever and deinit, which joins
+// the PipeWire thread, with it. Every handover and accept goes through here,
+// and stop and deinit release a callback still waiting. Loop lock held.
+static void hlSignalAndWait(void)
+{
+  // After stop nothing accepts any more, and deinit is about to join this
+  // thread: never wait then.
+  if (this->stop)
+    return;
+
+  this->awaitingAccept = true;
+  pw_thread_loop_signal(this->threadLoop, true);
+}
+
+static void hlAccept(void)
+{
+  this->awaitingAccept = false;
+  pw_thread_loop_accept(this->threadLoop);
+}
+
+static void hlReleaseWaiter(void)
+{
+  if (this->awaitingAccept)
+    hlAccept();
+}
+// HyperLab accept handshake (end)
+
