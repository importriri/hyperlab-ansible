-- Managed by hyperlab-ansible.
-- Physical host only.
--
-- PHASE 1 STATIC CONTRACT:
-- this file is not installed or started yet.
-- Sway remains the proven host compositor and recovery path.
-- HyperLab operational authority remains hyperlabctl/specs/contracts.

local input = require("hyperlab_input")
local palette = require("hyperlab_palette")
local main_mod = "SUPER"

hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")
hl.env("XDG_CURRENT_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_TYPE", "wayland")

hl.config({
    general = {
        gaps_in = 6,
        gaps_out = 4,
        border_size = 3,
        resize_on_border = true,
        allow_tearing = false,
        layout = "dwindle",

        col = {
            active_border = palette.active_border,
            inactive_border = palette.inactive_border,
        },
    },

    input = {
        kb_layout = input.keyboard_layout,
        kb_variant = input.keyboard_variant,
        kb_options = input.keyboard_options,
        follow_mouse = 0,

        touchpad = {
            disable_while_typing =
                input.touchpad.disable_while_typing,
            middle_button_emulation =
                input.touchpad.middle_button_emulation,
            natural_scroll =
                input.touchpad.natural_scroll,
            tap_to_click =
                input.touchpad.tap_to_click,
        },
    },

    misc = {
        force_default_wallpaper = 0,
        disable_hyprland_logo = true,
        focus_on_activate = true,
    },
})

-- Basic workstation parity.
hl.bind(
    main_mod .. " + Return",
    hl.dsp.exec_cmd("foot")
)

hl.bind(
    main_mod .. " + SHIFT + Return",
    hl.dsp.exec_cmd("foot --app-id=floatterm")
)

hl.bind(
    main_mod .. " + SHIFT + F",
    hl.dsp.exec_cmd("nemo")
)

hl.bind(
    main_mod .. " + D",
    hl.dsp.exec_cmd(
        "rofi -show drun "
        .. "-theme ~/.config/rofi/rofi-launcher.rasi"
    )
)

hl.bind(
    main_mod .. " + X",
    hl.dsp.exec_cmd(
        "/usr/local/bin/privatestack-powermenu"
    )
)

hl.bind(
    main_mod .. " + SHIFT + Q",
    hl.dsp.window.close()
)

hl.bind(
    main_mod .. " + F",
    hl.dsp.window.fullscreen({
        action = "toggle",
        mode = "fullscreen",
    })
)

hl.bind(
    main_mod .. " + SHIFT + SPACE",
    hl.dsp.window.float({
        action = "toggle",
    })
)

-- Focus parity.
hl.bind(
    main_mod .. " + H",
    hl.dsp.focus({ direction = "left" })
)

hl.bind(
    main_mod .. " + J",
    hl.dsp.focus({ direction = "down" })
)

hl.bind(
    main_mod .. " + K",
    hl.dsp.focus({ direction = "up" })
)

hl.bind(
    main_mod .. " + L",
    hl.dsp.focus({ direction = "right" })
)

-- Move parity.
hl.bind(
    main_mod .. " + SHIFT + H",
    hl.dsp.window.move({ direction = "left" })
)

hl.bind(
    main_mod .. " + SHIFT + J",
    hl.dsp.window.move({ direction = "down" })
)

hl.bind(
    main_mod .. " + SHIFT + K",
    hl.dsp.window.move({ direction = "up" })
)

hl.bind(
    main_mod .. " + SHIFT + L",
    hl.dsp.window.move({ direction = "right" })
)

-- Mouse move / resize parity.
hl.bind(
    main_mod .. " + mouse:272",
    hl.dsp.window.drag(),
    { mouse = true }
)

hl.bind(
    main_mod .. " + mouse:273",
    hl.dsp.window.resize(),
    { mouse = true }
)

-- Keyboard resize submap.
hl.bind(
    main_mod .. " + R",
    hl.dsp.submap("resize")
)

hl.define_submap("resize", function()
    hl.bind(
        "H",
        hl.dsp.window.resize({
            x = -10,
            y = 0,
            relative = true,
        }),
        { repeating = true }
    )

    hl.bind(
        "J",
        hl.dsp.window.resize({
            x = 0,
            y = 10,
            relative = true,
        }),
        { repeating = true }
    )

    hl.bind(
        "K",
        hl.dsp.window.resize({
            x = 0,
            y = -10,
            relative = true,
        }),
        { repeating = true }
    )

    hl.bind(
        "L",
        hl.dsp.window.resize({
            x = 10,
            y = 0,
            relative = true,
        }),
        { repeating = true }
    )

    hl.bind(
        "Return",
        hl.dsp.submap("reset")
    )

    hl.bind(
        "Escape",
        hl.dsp.submap("reset")
    )
end)

-- Workspaces 1-9.
for workspace = 1, 9 do
    local key = tostring(workspace)

    hl.bind(
        main_mod .. " + " .. key,
        hl.dsp.focus({
            workspace = workspace,
        })
    )

    hl.bind(
        main_mod .. " + SHIFT + " .. key,
        hl.dsp.window.move({
            workspace = workspace,
        })
    )
end

-- Proven compositor-neutral HyperLab surfaces.
hl.bind(
    main_mod .. " + F2",
    hl.dsp.exec_cmd(
        "/usr/local/bin/privatestack-hyperlab-domains "
        .. "--surface drawer --section diagnostics"
    )
)

hl.bind(
    main_mod .. " + F3",
    hl.dsp.exec_cmd(
        "foot --app-id=floatterm bash -lc "
        .. "'hyperlabctl doctor; read -r _'"
    )
)

hl.bind(
    main_mod .. " + F4",
    hl.dsp.exec_cmd(
        "/usr/local/bin/privatestack-hyperlab-domains "
        .. "--surface overlay --section vms"
    )
)

