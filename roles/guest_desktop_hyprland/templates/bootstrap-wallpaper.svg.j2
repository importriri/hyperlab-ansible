<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <linearGradient id="background" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#{{ guest_theme_palette.background }}"/>
      <stop offset="0.58" stop-color="#{{ guest_theme_palette.surface }}"/>
      <stop offset="1" stop-color="#{{ guest_theme_palette.background }}"/>
    </linearGradient>
    <radialGradient id="glow">
      <stop offset="0" stop-color="#{{ guest_theme_palette.accent_alt }}" stop-opacity="0.72"/>
      <stop offset="1" stop-color="#{{ guest_theme_palette.accent_alt }}" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect width="1920" height="1080" fill="url(#background)"/>
  <circle cx="{% if guest_theme_surface == 'desktop' %}1480{% else %}440{% endif %}" cy="270" r="520" fill="url(#glow)"/>
  <circle cx="{% if guest_theme_surface == 'desktop' %}420{% else %}1480{% endif %}" cy="850" r="460" fill="#{{ guest_theme_palette.accent }}" opacity="0.14"/>

  <g opacity="0.23" stroke="#{{ guest_theme_palette.accent }}" fill="none">
    <path d="M0 820 C420 620 620 1020 1040 780 S1580 580 1920 760" stroke-width="5"/>
    <path d="M0 880 C390 700 710 1060 1100 830 S1600 650 1920 820" stroke-width="2"/>
  </g>

  <g fill="#{{ guest_theme_palette.foreground }}">
    <text x="96" y="900" font-size="64" font-family="monospace">{{ guest_theme_name }}</text>
    <text x="101" y="955" font-size="25" opacity="0.72" font-family="monospace">guest workstation · {{ guest_theme_surface }}</text>
  </g>
</svg>
