# Managed by hyperlab-ansible.
# Physical-host candidate only. Not activated by the render gate.

general {
    hide_cursor = true
    immediate_render = true
}

background {
    monitor =
    path = /usr/share/backgrounds/privatestack/lockscreen.png
    blur_passes = 3
    blur_size = 7
}

input-field {
    monitor =
    size = 320, 56
    outline_thickness = 2
    dots_size = 0.22
    dots_spacing = 0.30
    fade_on_empty = false
    placeholder_text = Password
    position = 0, -40
    halign = center
    valign = center
}

label {
    monitor =
    text = HyperLab host
    font_size = 24
    position = 0, 55
    halign = center
    valign = center
}
