/* Catppuccin Mocha palette - imported by every theme in this brick */
* {
    base:     #1e1e2eff;
    mantle:   #181825ff;
    crust:    #11111bff;
    surface0: #313244ff;
    surface1: #45475aff;
    overlay0: #6c7086ff;
    text:     #cdd6f4ff;
    subtext0: #a6adc8ff;
    lavender: #b4befeff;
    mauve:    #cba6f7ff;
    blue:     #89b4faff;
    red:      #f38ba8ff;
    transparent: #00000000;
}
