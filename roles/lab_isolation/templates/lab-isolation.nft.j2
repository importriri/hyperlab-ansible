# Managed by hyperlab-ansible (roles/lab_isolation).
#
# Idempotent by construction: declare the table, flush ONLY this table,
# redefine it. NEVER flush ruleset - libvirt keeps runtime NAT rules that
# would not survive it. Reload the service, never restart it (the unit's
# stop action flushes the ruleset on Arch).

table {{ lab_isolation_table }}
flush table {{ lab_isolation_table }}

table {{ lab_isolation_table }} {
    chain forward {
        type filter hook forward priority -10; policy accept;

        # the lab forwards nothing, in no direction
        iifname "{{ lab_isolation_lab_bridge }}" counter drop
        oifname "{{ lab_isolation_lab_bridge }}" counter drop

        # default-deny matrix: no cross-bridge traffic between declared networks
{% for a in lab_isolation_guest_networks %}
{% for b in lab_isolation_guest_networks %}
{% if a.name != b.name %}
        iifname "{{ a.bridge }}" oifname "{{ b.bridge }}" counter drop
{% endif %}
{% endfor %}
{% endfor %}

        # Fail closed: no routed traffic between any two guest bridges, a
        # bridge nobody declared included.
        iifname "virbr*" oifname "virbr*" counter drop
    }

    # Guest to host is default deny. A guest reaches the host only for what
    # libvirt serves on its own bridge: DHCP, and DNS on its own gateway, so
    # no network can query another's resolver. Replies to connections the
    # host opened (SSH, provisioning) pass; everything else a guest sends to
    # the host, in IPv4 or IPv6, is dropped.
    chain input {
        type filter hook input priority -10; policy accept;
{% for d in lab_isolation_guest_networks %}

        iifname "{{ d.bridge }}" ct state established,related accept
        iifname "{{ d.bridge }}" udp sport 68 udp dport 67 accept
        iifname "{{ d.bridge }}" ip daddr {{ d.gateway }} udp dport 53 accept
        iifname "{{ d.bridge }}" ip daddr {{ d.gateway }} tcp dport 53 accept
        iifname "{{ d.bridge }}" counter drop
{% endfor %}

        # Fail closed: a guest bridge outside the declared networks reaches
        # nothing on the host, not even DHCP.
        iifname "virbr*" counter drop
    }
}
