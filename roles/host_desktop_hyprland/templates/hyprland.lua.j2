-- Reviewed physical-host audio ceiling.
hl.bind(
    "XF86AudioRaiseVolume",
    hl.dsp.exec_cmd(
        "wpctl set-volume -l 1.25 "
        .. "@DEFAULT_AUDIO_SINK@ 5%+"
    ),
    {
        locked = true,
        repeating = true,
    }
)

hl.bind(
    "XF86AudioLowerVolume",
    hl.dsp.exec_cmd(
        "wpctl set-volume "
        .. "@DEFAULT_AUDIO_SINK@ 5%-"
    ),
    {
        locked = true,
        repeating = true,
    }
)

hl.bind(
    "XF86AudioMute",
    hl.dsp.exec_cmd(
        "wpctl set-mute "
        .. "@DEFAULT_AUDIO_SINK@ toggle"
    ),
    {
        locked = true,
    }
)

hl.bind(
    "XF86MonBrightnessUp",
    hl.dsp.exec_cmd(
        "brightnessctl set +5%"
    ),
    {
        locked = true,
        repeating = true,
    }
)

hl.bind(
    "XF86MonBrightnessDown",
    hl.dsp.exec_cmd(
        "brightnessctl set 5%-"
    ),
    {
        locked = true,
        repeating = true,
    }
)

-- Screenshot helper is already compositor-neutral.
hl.bind(
    "Print",
    hl.dsp.exec_cmd(
        "/usr/local/bin/privatestack-screenshot full"
    )
)

hl.bind(
    "SHIFT + Print",
    hl.dsp.exec_cmd(
        "/usr/local/bin/privatestack-screenshot region"
    )
)

hl.bind(
    "CTRL + Print",
    hl.dsp.exec_cmd(
        "/usr/local/bin/privatestack-screenshot region choose"
    )
)

-- Hyprlock is the selected host lock backend.
hl.bind(
    main_mod .. " + Escape",
    hl.dsp.exec_cmd(
        "pidof hyprlock || hyprlock"
    )
)

