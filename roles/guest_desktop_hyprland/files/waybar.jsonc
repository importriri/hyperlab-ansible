{
  "layer": "top",
  "position": "top",
  "height": 37,
  "spacing": 6,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [],

  "modules-right": [
    "custom/headless",
    "custom/lg",
    "clock",
    "custom/theme",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "disk",
    "tray"
  ],

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true
  },

  "hyprland/window": {
    "max-length": 48
  },

  "custom/headless": {
    "exec": "hyprctl -j monitors | jq -r 'map(select(.name == \"HEADLESS-0\"))[0] | if . == null then \"HEADLESS-0 · unavailable\" else \"\\(.name) · \\(.width)x\\(.height)@\\(.refreshRate|floor) · scale \\(.scale)\" end'",
    "interval": 2
  },

  "custom/lg": {
    "exec": "sh -c 'if pgrep -u \"$(id -u)\" -f \"^/usr/local/bin/looking-glass-host([[:space:]]|$)\" >/dev/null; then printf \"LG · ON\\n\"; else printf \"LG · OFF\\n\"; fi'",
    "interval": 1
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "custom/theme": {
    "exec": "privatestack-guest-theme status",
    "interval": 5,
    "on-click": "privatestack-guest-theme next",
    "on-click-right": "privatestack-guest-theme menu",
    "format": "󰏘 {}"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pamixer -t"
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰤭 offline"
  },

  "cpu": {
    "format": " {usage}%"
  },

  "memory": {
    "format": " {}%"
  },

  "disk": {
    "interval": 30,
    "format": " {percentage_used}%"
  },

  "tray": {
    "spacing": 8
  }
}
