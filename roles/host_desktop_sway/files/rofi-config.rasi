/* Default application launcher configuration. */
configuration {
    modes:               "drun,run,window";
    font:                "JetBrainsMono Nerd Font 11";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun:        "apps";
    display-run:         "run";
    display-window:      "win";
    disable-history:     false;

    /* Keep keyboard focus stable instead of following every mouse crossing. */
    hover-select:        false;
}

@theme "rofi-launcher.rasi"
