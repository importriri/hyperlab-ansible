/* HyperLab compatibility aliases backed by the selected shared palette. */
@import "~/.config/hyperlab/palette.rasi"

* {
    base:        @hl-base;
    mantle:      @hl-mantle;
    crust:       @hl-base;
    surface0:    @hl-surface;
    surface1:    @hl-overlay;
    overlay0:    @hl-subtext;
    text:        @hl-text;
    subtext0:    @hl-subtext;
    accent:      @hl-accent;
    accent2:     @hl-accent2;
    lavender:    @hl-accent2;
    mauve:       @hl-dom-lab;
    blue:        @hl-accent2;
    red:         @hl-bad;
    transparent: #00000000;
}
