{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "start_hidden": false,
    "ipc": false,
    "exclusive": true,
    "passthrough": false,
    "fixed-center": true,
    "height": 37,
    "on-sigusr1": "toggle",
    "on-sigusr2": "reload",
    "spacing": 0,
    "modules-left": ["sway/workspaces", "custom/brand", "group/hyperlab", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["group/telemetry", "group/session"],

    "custom/brand": {
        "format": "  HyperLab",
        "tooltip": true,
        "tooltip-format": "Open the compact HyperLab drawer",
        "on-click": "/usr/local/bin/privatestack-hyperlab-domains --surface drawer --section vms",
        "on-click-right": "/usr/local/bin/privatestack-hyperlab-domains --surface drawer --section diagnostics",
        "on-click-middle": "/usr/local/bin/privatestack-hyperlab-domains --surface overlay --section vms"
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },
    // Definitive mockup order: workspaces first, then the HyperLab pod. The trust
    // stream stays attached to that pod so the bar keeps real runtime data rather
    // than prototype counters.
    "group/hyperlab": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 70,
            "transition-left-to-right": true,
            "children-class": "trust-detail",
            "reveal-delay": 40
        },
        "modules": ["custom/hyperlab", "custom/hyperlab-ram", "custom/hyperlab-gpu", "custom/hyperlab-vms"]
    },
    // The collapsed pill is a STREAM, not a poll: hyperlabctl blocks on
    // `virsh event` and prints the instant a domain moves. No "interval" here on
    // purpose - restart-interval only covers libvirt going away underneath it.
    // The drawer pills, visible only while the mouse is over the group, stay on
    // a slow poll plus SIGRTMIN+8 after anything the CLI itself caused.
    "custom/hyperlab": {
        "exec": "/usr/local/bin/privatestack-hyperlab watch trust",
        "return-type": "json",
        "restart-interval": 10,
        "format": "TRUST {}",
        "max-length": 20,
        "tooltip": true,
        "on-click": "/usr/local/bin/privatestack-hyperlab-domains --surface drawer --section diagnostics",
        "on-click-right": "/usr/local/bin/privatestack-hyperlab-domains --surface drawer --section diagnostics",
        "on-click-middle": "/usr/local/bin/privatestack-hyperlab-domains --surface overlay --section diagnostics"
    },
    "custom/hyperlab-ram": {
        "exec": "/usr/local/bin/privatestack-hyperlab ram",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "format": " RAM {}"
    },
    "custom/hyperlab-gpu": {
        "exec": "/usr/local/bin/privatestack-hyperlab gpu",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "format": " GPU {}"
    },
    "custom/hyperlab-vms": {
        "exec": "/usr/local/bin/privatestack-hyperlab vms",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "format": " VM {}",
        "on-click": "/usr/local/bin/privatestack-hyperlab-domains --surface drawer --section vms",
        "on-click-right": "/usr/local/bin/privatestack-hyperlab-domains --surface drawer --section diagnostics"
    },


    "group/telemetry": {
        "orientation": "horizontal",
        "modules": ["temperature", "network", "pulseaudio", "battery"]
    },
    "group/session": {
        "orientation": "horizontal",
        "modules": ["custom/keyboard-layout", "custom/wallpaper-mode", "custom/controls"]
    },

    "custom/keyboard-layout": {
        "exec": "/usr/local/bin/privatestack-keyboard status-json",
        "return-type": "json",
        "interval": 5,
        "signal": 10,
        "format": "{}",
        "tooltip": true,
        "on-click": "/usr/local/bin/privatestack-keyboard cycle",
        "on-click-right": "/usr/local/bin/privatestack-controls keyboard"
    },
    "custom/controls": {
        "exec": "/usr/local/bin/privatestack-controls status-json",
        "return-type": "json",
        "interval": 5,
        "signal": 11,
        "format": "{}",
        "tooltip": true,
        "on-click": "/usr/local/bin/privatestack-controls menu"
    },

    "custom/wallpaper-mode": {
        "exec": "/usr/local/bin/privatestack-theme mode-json",
        "return-type": "json",
        "interval": 5,
        "signal": 9,
        "format": "{}",
        "tooltip": true,
        "on-click": "/usr/local/bin/privatestack-theme mode-toggle"
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    // No hwmon-path: waybar falls back to thermal_zone0. Pin a zone here if
    // that one reads the wrong die on your board.
    "temperature": {
        "critical-threshold": 82,
        "format": " {temperatureC}°C",
        "tooltip-format": "CPU temperature: {temperatureC}°C"
    },
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰖪  offline",
        "tooltip-format": "{ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  mute",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "max-volume": 125,
        "scroll-step": 5
    }
}
