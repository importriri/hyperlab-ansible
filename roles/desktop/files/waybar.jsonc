{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,
    "modules-left": ["custom/logo", "sway/workspaces", "sway/mode", "custom/cava"],
    "modules-center": ["clock"],
    "modules-right": ["group/hyperlab", "idle_inhibitor", "pulseaudio", "backlight", "network", "cpu", "memory", "temperature", "battery", "tray"],

    "custom/logo": {
        "format": "  ",
        "tooltip": false,
        "on-click": "/usr/local/bin/privatestack-powermenu"
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },
    // Continuous custom module: no "interval" on purpose - waybar reads the
    // script's stdout as a stream, one line per cava frame.
    "custom/cava": {
        "exec": "/usr/local/bin/privatestack-cava",
        "tooltip": false,
        "restart-interval": 5
    },
    // The Hyperlab cockpit. Collapsed it is one pill: the trust level, because
    // that is the only lab fact you cannot recover by looking. Hovering opens
    // the drawer over the other three. Every pill is the same script with a
    // different field, and every payload carries the same four keys, so one
    // set of CSS rules covers all of them.
    "group/hyperlab": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 300, "transition-left-to-right": false },
        "modules": ["custom/hyperlab", "custom/hyperlab-ram", "custom/hyperlab-gpu", "custom/hyperlab-vms"]
    },
    // The collapsed pill is a STREAM, not a poll: hyperlabctl blocks on
    // `virsh event` and prints the instant a domain moves. No "interval" here on
    // purpose - restart-interval only covers libvirt going away underneath it.
    // The drawer pills, visible only while the mouse is over the group, stay on
    // a slow poll plus SIGRTMIN+8 after anything the CLI itself caused.
    "custom/hyperlab": {
        "exec": "/usr/local/bin/privatestack-hyperlab watch trust",
        "return-type": "json",
        "restart-interval": 10,
        "format": "  {}",
        "on-click": "/usr/local/bin/privatestack-hyperlab-palette",
        "on-click-right": "foot --app-id=hyperlab-panel hyperlabctl panel"
    },
    "custom/hyperlab-ram": {
        "exec": "/usr/local/bin/privatestack-hyperlab ram",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "format": "  {}"
    },
    "custom/hyperlab-gpu": {
        "exec": "/usr/local/bin/privatestack-hyperlab gpu",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "format": "  {}"
    },
    "custom/hyperlab-vms": {
        "exec": "/usr/local/bin/privatestack-hyperlab vms",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "format": "  {}",
        "on-click": "foot --app-id=hyperlab-panel hyperlabctl panel"
    },
    "clock": {
        "format": "  {:%a %d %b   %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" },
        "tooltip": false
    },
    "cpu": { "format": "  {usage}%", "interval": 5 },
    "memory": { "format": "  {}%", "interval": 10 },
    // No hwmon-path: waybar falls back to thermal_zone0. Pin a zone here if
    // that one reads the wrong die on your board.
    "temperature": {
        "critical-threshold": 82,
        "format": "  {temperatureC}°C"
    },
    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["", "", "", ""],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰖪  offline",
        "tooltip-format": "{ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  mute",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pamixer -t",
        "scroll-step": 5
    },
    "tray": { "icon-size": 16, "spacing": 8 }
}
