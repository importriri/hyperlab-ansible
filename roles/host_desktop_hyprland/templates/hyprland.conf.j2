# HyperLab physical-host Hyprland Phase 1 reference.
#
# STATIC ONLY: this template is not rendered by a playbook and is not installed
# on the host during Phase 1.
#
# Operational authority remains hyperlabctl/specs/contracts.
# Sway remains the proven selectable recovery compositor.

$mainMod = SUPER
$term = foot
$fileManager = nemo
$menu = rofi -show drun -theme ~/.config/rofi/rofi-launcher.rasi
$powerMenu = /usr/local/bin/privatestack-powermenu

source = ~/.config/hypr/hyperlab-input.conf

general {
    gaps_in = 6
    gaps_out = 4
    border_size = 3
}

input {
    follow_mouse = 0
}

# Basic workstation parity.
bind = $mainMod, RETURN, exec, $term
bind = $mainMod SHIFT, RETURN, exec, foot --app-id=floatterm
bind = $mainMod SHIFT, F, exec, $fileManager
bind = $mainMod, D, exec, $menu
bind = $mainMod, X, exec, $powerMenu
bind = $mainMod SHIFT, Q, killactive
bind = $mainMod, F, fullscreen, 0
bind = $mainMod SHIFT, SPACE, togglefloating

bind = $mainMod, H, movefocus, l
bind = $mainMod, J, movefocus, d
bind = $mainMod, K, movefocus, u
bind = $mainMod, L, movefocus, r
bind = $mainMod SHIFT, H, movewindow, l
bind = $mainMod SHIFT, J, movewindow, d
bind = $mainMod SHIFT, K, movewindow, u
bind = $mainMod SHIFT, L, movewindow, r

bind = $mainMod, R, submap, resize

submap = resize
binde = , H, resizeactive, -10 0
binde = , J, resizeactive, 0 10
binde = , K, resizeactive, 0 -10
binde = , L, resizeactive, 10 0
bind = , RETURN, submap, reset
bind = , ESCAPE, submap, reset
submap = reset

# Workspaces 1-9.
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9

bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9

# Existing compositor-neutral HyperLab surfaces remain backend clients.
bind = $mainMod, F2, exec, /usr/local/bin/privatestack-hyperlab-domains --surface drawer --section diagnostics
bind = $mainMod, F3, exec, foot --app-id=floatterm bash -lc 'hyperlabctl doctor; read -r _'
bind = $mainMod, F4, exec, /usr/local/bin/privatestack-hyperlab-domains --surface overlay --section vms

# The VM drawer route is retained explicitly.
# HYPERLAB_PARITY_ROUTE: /usr/local/bin/privatestack-hyperlab-domains --surface drawer --section vms

# Looking Glass and SPICE stay backend-owned, not compositor-owned.
# HYPERLAB_PARITY_ROUTE: hyperlabctl open looking-glass
# HYPERLAB_PARITY_ROUTE: hyperlabctl open console

# Host audio policy keeps the reviewed 125 percent software ceiling.
bindel = , XF86AudioRaiseVolume, exec, wpctl set-volume -l 1.25 @DEFAULT_AUDIO_SINK@ 5%+
bindel = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindl = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

bindel = , XF86MonBrightnessUp, exec, brightnessctl set +5%
bindel = , XF86MonBrightnessDown, exec, brightnessctl set 5%-

bind = , PRINT, exec, /usr/local/bin/privatestack-screenshot full
bind = SHIFT, PRINT, exec, /usr/local/bin/privatestack-screenshot region
bind = CTRL, PRINT, exec, /usr/local/bin/privatestack-screenshot region choose

# hyprlock/hypridle replace Sway-specific lock and DPMS IPC in a later runtime
# milestone. Phase 1 declares the selected backends without starting them.
bind = $mainMod, ESCAPE, exec, hyprlock

# Existing implementations of these controls call swaymsg or depend on SWAYSOCK
# and therefore need explicit compositor adapters before activation.
# HYPERLAB_PARITY_ADAPTER_REQUIRED: keyboard-cycle
# HYPERLAB_PARITY_ADAPTER_REQUIRED: machine-theme-key
# HYPERLAB_PARITY_ADAPTER_REQUIRED: theme-cycle
# HYPERLAB_PARITY_ADAPTER_REQUIRED: wallpaper-mode
# HYPERLAB_PARITY_ADAPTER_REQUIRED: wallpaper-daemon
# HYPERLAB_PARITY_ADAPTER_REQUIRED: controls-menu
# HYPERLAB_PARITY_ADAPTER_REQUIRED: bar-toggle

# Quickshell is Phase 2. No QML process is started here.
# HYPERLAB_QUICKSHELL_PHASE=2
