-- Managed by hyperlab-ansible.
-- Guest workstation only. HyperLab host controls never belong here.

require("theme")

local main_mod = "SUPER"

{% if guest_desktop_hyprland_headless_monitor %}
hl.monitor({
    output = "{{ guest_desktop_hyprland_headless_output }}",
    mode = "{{ guest_desktop_hyprland_headless_mode }}",
    position = "{{ guest_desktop_hyprland_headless_position }}",
    scale = {{ guest_desktop_hyprland_headless_scale }},
})
{% else %}
hl.monitor({
    output = "",
    mode = "preferred",
    position = "auto",
    scale = "auto",
})
{% endif %}

hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")
hl.env("XDG_CURRENT_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_TYPE", "wayland")

hl.config({
    general = {
        gaps_in = 6,
        gaps_out = 12,
        border_size = 2,
        resize_on_border = true,
        allow_tearing = false,
        layout = "dwindle",

    },

    decoration = {
        rounding = 10,
        rounding_power = 2,

        blur = {
            enabled = true,
            size = 6,
            passes = 3,
        },

        shadow = {
            enabled = true,
            range = 24,
            render_power = 3,
        },
    },

    animations = {
        enabled = true,
    },

    input = {
        kb_layout = "it,us,ara",
        follow_mouse = 1,

        touchpad = {
            natural_scroll = true,
        },
    },

    dwindle = {
        preserve_split = true,
    },

    misc = {
        force_default_wallpaper = 0,
        disable_hyprland_logo = true,
        focus_on_activate = true,
    },
})

hl.curve(
    "guestEase",
    {
        type = "bezier",
        points = {
            {0.16, 1},
            {0.30, 1},
        },
    }
)

hl.animation({
    leaf = "windows",
    enabled = true,
    speed = 6,
    bezier = "guestEase",
})

hl.animation({
    leaf = "windowsIn",
    enabled = true,
    speed = 5,
    bezier = "guestEase",
    style = "popin 80%",
})

hl.animation({
    leaf = "windowsOut",
    enabled = true,
    speed = 5,
    bezier = "guestEase",
    style = "popin 80%",
})

hl.animation({
    leaf = "border",
    enabled = true,
    speed = 8,
    bezier = "guestEase",
})

hl.animation({
    leaf = "fade",
    enabled = true,
    speed = 5,
    bezier = "guestEase",
})

hl.animation({
    leaf = "workspaces",
    enabled = true,
    speed = 5,
    bezier = "guestEase",
    style = "slide",
})

hl.on("hyprland.start", function()
{% if guest_desktop_hyprland_headless_monitor %}
    hl.exec_cmd(
        "hyprctl output create headless "
        .. "{{ guest_desktop_hyprland_headless_output }}"
    )
{% endif %}
    hl.exec_cmd(
        "dbus-update-activation-environment "
        .. "--systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP"
    )

    hl.exec_cmd(
        "systemctl --user start hyprpolkitagent.service"
    )

    hl.exec_cmd("waybar")
    hl.exec_cmd("mako")
    hl.exec_cmd("hypridle")

    hl.exec_cmd(
        "sleep 1 && "
        .. "privatestack-guest-theme session-start"
    )

    hl.exec_cmd(
        "wl-paste --type text --watch cliphist store"
    )
end)

hl.bind(
    main_mod .. " + Return",
    hl.dsp.exec_cmd("kitty")
)

hl.bind(
    main_mod .. " + E",
    hl.dsp.exec_cmd("thunar")
)

hl.bind(
    main_mod .. " + D",
    hl.dsp.exec_cmd("hyprlauncher")
)

hl.bind(
    main_mod .. " + R",
    hl.dsp.exec_cmd("rofi -show drun")
)

hl.bind(
    main_mod .. " + ALT + T",
    hl.dsp.exec_cmd(
        "privatestack-guest-theme next"
    )
)

hl.bind(
    main_mod .. " + ALT + W",
    hl.dsp.exec_cmd(
        "privatestack-guest-theme wallpaper-next"
    )
)

hl.bind(
    main_mod .. " + L",
    hl.dsp.exec_cmd(
        "pidof hyprlock || hyprlock"
    )
)

hl.bind(
    main_mod .. " + Q",
    hl.dsp.window.close()
)

hl.bind(
    main_mod .. " + F",
    hl.dsp.exec_cmd(
        "hyprctl dispatch fullscreen 1"
    )
)

hl.bind(
    main_mod .. " + V",
    hl.dsp.window.float({
        action = "toggle",
    })
)

hl.bind(
    main_mod .. " + P",
    hl.dsp.window.pseudo()
)

hl.bind(
    main_mod .. " + J",
    hl.dsp.layout("togglesplit")
)

hl.bind(
    main_mod .. " + left",
    hl.dsp.focus({
        direction = "left",
    })
)

hl.bind(
    main_mod .. " + right",
    hl.dsp.focus({
        direction = "right",
    })
)

hl.bind(
    main_mod .. " + up",
    hl.dsp.focus({
        direction = "up",
    })
)

hl.bind(
    main_mod .. " + down",
    hl.dsp.focus({
        direction = "down",
    })
)

hl.bind(
    main_mod .. " + SHIFT + left",
    hl.dsp.window.move({
        direction = "left",
    })
)

hl.bind(
    main_mod .. " + SHIFT + right",
    hl.dsp.window.move({
        direction = "right",
    })
)

hl.bind(
    main_mod .. " + SHIFT + up",
    hl.dsp.window.move({
        direction = "up",
    })
)

hl.bind(
    main_mod .. " + SHIFT + down",
    hl.dsp.window.move({
        direction = "down",
    })
)

for workspace = 1, 9 do
    local key = tostring(workspace)

    hl.bind(
        main_mod .. " + " .. key,
        hl.dsp.focus({
            workspace = workspace,
        })
    )

    hl.bind(
        main_mod .. " + SHIFT + " .. key,
        hl.dsp.window.move({
            workspace = workspace,
        })
    )
end

hl.bind(
    main_mod .. " + mouse:272",
    hl.dsp.window.drag(),
    {
        mouse = true,
    }
)

hl.bind(
    main_mod .. " + mouse:273",
    hl.dsp.window.resize(),
    {
        mouse = true,
    }
)

hl.bind(
    "XF86AudioRaiseVolume",
    hl.dsp.exec_cmd(
        "wpctl set-volume -l 1 "
        .. "@DEFAULT_AUDIO_SINK@ 5%+"
    ),
    {
        locked = true,
        repeating = true,
    }
)

hl.bind(
    "XF86AudioLowerVolume",
    hl.dsp.exec_cmd(
        "wpctl set-volume "
        .. "@DEFAULT_AUDIO_SINK@ 5%-"
    ),
    {
        locked = true,
        repeating = true,
    }
)

hl.bind(
    "XF86AudioMute",
    hl.dsp.exec_cmd(
        "wpctl set-mute "
        .. "@DEFAULT_AUDIO_SINK@ toggle"
    ),
    {
        locked = true,
    }
)

hl.bind(
    "XF86AudioPlay",
    hl.dsp.exec_cmd("playerctl play-pause"),
    {
        locked = true,
    }
)

hl.bind(
    "XF86AudioNext",
    hl.dsp.exec_cmd("playerctl next"),
    {
        locked = true,
    }
)

hl.bind(
    "XF86AudioPrev",
    hl.dsp.exec_cmd("playerctl previous"),
    {
        locked = true,
    }
)

hl.window_rule({
    name = "float-file-roller",

    match = {
        class = "org.gnome.FileRoller",
    },

    float = true,
})
